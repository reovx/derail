# Stellar network the app targets. `testnet` (default) or `public`.
# Mainnet is deliberately out of scope until Level 6 — see SPEC-BELT-LEVELS.md §3.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Supabase — project URL and publishable key. Both are safe in the browser:
# every table has RLS enabled and reads are scoped to the owning user.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role key. Server-side only — it bypasses RLS entirely.
# Used by the ingest endpoint and the poller, which authenticate callers by
# project ingest token rather than by a Supabase session. Never expose this to
# the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The single project MVP 1 is scoped to (scripts/seed-project.mjs prints its id).
# Replaced by session-scoped queries with RLS once GitHub OAuth lands.
DERAIL_PROJECT_ID=

# The deployed derail_gate and the target it governs (SPEC-BELT-LEVELS.md §2).
# Public ledger addresses, not secrets — the browser signs approvals against them.
# Deploy your own with scripts/deploy-gate.sh; these are the live testnet pair.
NEXT_PUBLIC_DERAIL_GATE_ID=CCB3XL2VY6WGWGSVVRNBWGZZQ3SSXVRCMUTJ3XVFU7R5N2MS7UYOVL4D
NEXT_PUBLIC_DERAIL_TARGET_ID=CB5CD7U6HTHZNEYGR7XYOJOOR2NJ2DMNP5ULYIWN5LSLLOK32YLVPVLW

# The public demo target — SPEC-DEMO-GATE.md. A third target on the same gate
# that anyone can join and sign one real approval (or rejection) against; the
# Level 4 user-proof engine. Deploy and register it with
# scripts/deploy-demo-target.sh, then paste the id it prints here. Public.
NEXT_PUBLIC_DERAIL_DEMO_TARGET_ID=

# Relayer keys that sponsor the join — server-only secrets, never NEXT_PUBLIC_.
# Both addresses must be in the demo target's approver set (the deploy script
# registers them). A adds the newcomer; B proposes the sample. The relayer's
# authority is over the demo target and nothing else.
DERAIL_DEMO_RELAYER_A_SECRET=
DERAIL_DEMO_RELAYER_B_SECRET=

# The wasm hash the sample proposal upgrades to. Use the demo target's own hash
# for a harmless no-op — the deploy script prints it.
DERAIL_DEMO_SAFE_WASM_HASH=

# The services this gate governs, for the cross-service review queue (/queue).
# A JSON array of { "id": "C...", "name": "billing-service" }. One gate can hold
# the upgrade authority for many targets; list them here and the queue shows
# every open proposal across them, the ones waiting on the connected wallet
# first. Unset, the queue falls back to the single pinned target above and the
# Queue nav item stays hidden — it earns its place only with more than one
# service. Public: these are ledger addresses the browser already signs against.
NEXT_PUBLIC_DERAIL_SERVICES=

# Display names for approver addresses, so a reviewer sees who they are signing
# alongside rather than a bare address. A JSON object of { "G...": "Name" }.
# Unset, every address renders as before. Public and no more secret than the
# addresses themselves.
NEXT_PUBLIC_DERAIL_ROSTER=
