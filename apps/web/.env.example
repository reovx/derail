# Stellar network the app targets. `testnet` (default) or `public`.
# Mainnet is deliberately out of scope until Level 6 — see SPEC-BELT-LEVELS.md §3.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Supabase — project URL and publishable key. Both are safe in the browser:
# every table has RLS enabled and reads are scoped to the owning user.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role key. Server-side only — it bypasses RLS entirely.
# Used by the ingest endpoint and the poller, which authenticate callers by
# project ingest token rather than by a Supabase session. Never expose this to
# the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The single project MVP 1 is scoped to (scripts/seed-project.mjs prints its id).
# Replaced by session-scoped queries with RLS once GitHub OAuth lands.
DERAIL_PROJECT_ID=
